[% if ('lean' in languages and workflows) or typescript_components %]
{
  pkgs,
[% if 'lean' in languages %]
  inputs,
[% endif %]
[% if workflows or typescript_components %]
  lib,
[% endif %]
[% if typescript_components %]
  config,
[% endif %]
  ...
}:
[% else %]
{ pkgs[% if 'lean' in languages %], inputs[% endif %][% if workflows %], lib[% endif %], ... }:
[% endif %]
{
  name = [[ project_slug | tojson ]];
  packages =
    assert builtins.elem pkgs.stdenv.hostPlatform.system [
      "x86_64-linux"
      "aarch64-linux"
    ];
    with pkgs;
    [
      git
      just
      prek
      rumdl
      lychee
      nixfmt
      statix
      deadnix
      actionlint
      shellcheck
      shfmt
      tombi
      just-lsp
      ripgrep
[% if workflows or agents or 'python' in languages or 'lean' in languages %]
      python313
      uv
[% endif %]
[% if 'python' in languages %]
      ruff
      pyrefly
[% endif %]
[% if workflows %]
      (callPackage ./pkgs/schematter.nix { })
[% endif %]
[% if workflows %]
      patchelf
[% endif %]
[% if 'typescript' in languages %]
      bun
[% if typescript_components %]
      nodejs_24
      chromium
[% endif %]
[% endif %]
[% if 'go' in languages %]
      go
      golangci-lint
      govulncheck
[% endif %]
[% if 'rust' in languages %]
      rustc
      cargo
      clippy
      rustfmt
      cargo-nextest
      cargo-shear
      cargo-deny
      cargo-llvm-cov
[% endif %]
[% if agents %]
      (callPackage ./pkgs/agentsync.nix { })
[% endif %]
[% if 'go' in languages or 'rust' in languages or 'lean' in languages %]
      stdenv.cc
[% endif %]
[% if 'lean' in languages %]
      (import ./pkgs/lean-toolchain.nix {
        inherit pkgs;
        inherit (inputs) lean4-nix;
      })
      curl
      gnutar
      zstd
      graphviz
      swig
[% endif %]
[% if 'latex' in languages or 'lean' in languages %]
      tectonic
[% endif %]
[% if 'latex' in languages %]
      tex-fmt
[% endif %]
[% if 'latex' in languages or 'lean' in languages %]
[% if 'latex' in languages and 'lean' in languages %]
      (texliveInfraOnly.withPackages (ps: [
        ps.chktex
        ps.kpathsea
      ]))
[% else %]
      (texliveInfraOnly.withPackages (ps: [[ '[ ps.chktex ]' if 'latex' in languages else '[ ps.kpathsea ]' ]]))
[% endif %]
[% endif %]
[% if 'reference' in workflows and 'latex' in languages %]
      pandoc
[% endif %]
[% if secrets %]
      secretspec
[% endif %]
    ];
  env = {
[% if typescript_components %]
    DATABASE_URL = "postgresql://exordio@127.0.0.1:${toString config.processes.postgres.ports.main.value}/exordio";
    SMTP_HOST = "127.0.0.1";
    SMTP_PORT = toString config.processes.mailpit.ports.smtp.value;
    PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH = "${pkgs.chromium}/bin/chromium";
    LD_LIBRARY_PATH = lib.makeLibraryPath [ pkgs.stdenv.cc.cc.lib ];
    NEXT_TELEMETRY_DISABLED = "1";
    STORYBOOK_DISABLE_TELEMETRY = "1";
[% endif %]
    UV_PYTHON_DOWNLOADS = "never";
[% if 'go' in languages %]
    GOTOOLCHAIN = "local";
[% endif %]
[% if workflows or agents or 'python' in languages or 'lean' in languages %]
    UV_PYTHON = "${pkgs.python313}/bin/python3";
[% endif %]
[% if 'typescript' in languages %]
    BIOME_BINARY = "@biomejs/cli-linux-${
      if pkgs.stdenv.hostPlatform.isx86_64 then "x64" else "arm64"
    }-musl/biome";
[% endif %]
[% if 'rust' in languages %]
    LLVM_COV = "${pkgs.rustc.llvmPackages.llvm}/bin/llvm-cov";
    LLVM_PROFDATA = "${pkgs.rustc.llvmPackages.llvm}/bin/llvm-profdata";
[% endif %]
[% if 'lean' in languages %]
    LEAN_BLUEPRINT_CFLAGS = "-I${pkgs.lib.getDev pkgs.graphviz}/include";
    LEAN_BLUEPRINT_LDFLAGS = "-L${pkgs.lib.getLib pkgs.graphviz}/lib -L${pkgs.lib.getLib pkgs.graphviz}/lib/graphviz -Wl,-rpath,${pkgs.lib.getLib pkgs.graphviz}/lib:${pkgs.lib.getLib pkgs.graphviz}/lib/graphviz";
[% endif %]
[% if workflows %]
    PROJECT_RUNTIME_LINKER = pkgs.stdenv.cc.bintools.dynamicLinker;
    PROJECT_RUNTIME_LIBRARIES = lib.makeLibraryPath [
      pkgs.stdenv.cc.cc.lib
      pkgs.glibc
      pkgs.zlib
    ];
[% endif %]
  };
[% if typescript_components %]
  # Development services bind only to loopback; production uses explicit configuration.
  services.postgres = {
    enable = true;
    package = pkgs.postgresql_17;
    listen_addresses = "127.0.0.1";
    port = 55432;
    initialDatabases = [
      {
        name = "exordio";
        user = "exordio";
      }
    ];
  };
  services.mailpit = {
    enable = true;
    uiListenAddress = "127.0.0.1:8025";
    smtpListenAddress = "127.0.0.1:1025";
  };
[% endif %]
  enterShell = "unset PYTHONPATH PYTHONHOME VIRTUAL_ENV";
  enterTest = "just check";
}
