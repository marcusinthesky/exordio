{
  "name": "example-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "run": "bun run apps/example-app/src/main.ts",
    "build": "bun build apps/example-app/src/main.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  }
}
