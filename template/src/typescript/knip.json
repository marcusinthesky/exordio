{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/example-app": {
      "entry": [
        "src/main.ts",
        "src/main.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/index.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "includeEntryExports": true
    }
  }
}
