# Explicit local setup writes an ignored .env.local with a random auth secret.
# Configure production values through your hosting environment or SecretSpec.
APP_ENV=development
DATABASE_URL=postgresql://exordio:exordio@127.0.0.1:55432/exordio
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
EMAIL_FROM="Exordio <noreply@localhost>"
