package greet_test

import (
	"testing"

	"[[ go_module ]]/greet"
)

func TestMessage(t *testing.T) {
	tests := []struct {
		name string
		want string
	}{
		{name: "Ada", want: "Hello, Ada!"},
		{name: "", want: "Hello, world!"},
		{name: "Zoë", want: "Hello, Zoë!"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := greet.Message(tt.name); got != tt.want {
				t.Errorf("Message(%q) = %q, want %q", tt.name, got, tt.want)
			}
		})
	}
}
